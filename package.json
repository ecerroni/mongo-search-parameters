{
  "name": "@ecerroni/mongo-search-parameters",
  "version": "1.3.0",
  "description": "Easy find() search parameters",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "/build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "prepare": "husky",
    "test:clear-cache": "jest --clearCache",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf build",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build",
    "preversion": "npm run prettify && npm run lint && npm test && npm run prepare",
    "prettify": "prettier --write \"src/**/*.{ts,js}\" \"__tests__/**/*.{ts,js}\"",
    "version": "standard-changelog && git add CHANGELOG.md",
    "postpublish": "git push https://github.com/ecerroni/mongo-search-parameters.git master --follow-tags"
  },
  "author": "Enrico Cerroni",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecerroni/mongo-search-parameters"
  },
  "license": "MIT",
  "keywords": [
    "mongo",
    "noSql",
    "mongodb",
    "mongoose",
    "queries",
    "search parameters"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "mongodb-memory-server-core": "^9.2.0",
    "mongoose": "^8.10.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "standard-changelog": "^2.0.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "waait": "^1.0.5"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
